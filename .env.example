# Server
PORT=4000
DATABASE_URL=postgres://incident_hub:incident_hub@localhost:5433/incident_hub
CLIENT_ORIGIN=http://localhost:5173

# Slack — see docs/slack-integration.md for setup steps.
# Leave SLACK_BOT_TOKEN empty to use a stubbed message list for local testing.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Client
VITE_API_BASE_URL=http://localhost:4000
